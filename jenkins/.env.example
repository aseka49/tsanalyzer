# Copy to .env and adjust. The .env file is ignored by git: never commit real tokens.

# Jenkins login
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin123

# Optional: push images to Docker Hub. Create an access token at
# https://app.docker.com/settings/personal-access-tokens (Read & Write) and fill both values.
# Leave empty to keep images local (the "Push to Docker Hub" stage is then skipped).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Repository the pipeline builds
REPO_URL=https://github.com/aseka49/tsanalyzer.git
